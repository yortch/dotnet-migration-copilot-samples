@{
    ViewData["Title"] = "Admin Notifications";
}

<div class="row">
    <div class="col-md-12">
        <h2>@ViewData["Title"]</h2>
        <p class="text-muted">Real-time notifications for entity operations across the system.</p>

        <div class="alert alert-info" role="alert">
            <strong>Real-time Notifications</strong><br />
            You will receive notifications when any entity (students, courses, instructors, departments) is created, updated, or deleted.
        </div>

        <div class="panel panel-default">
            <div class="panel-heading">
                <h3 class="panel-title">Monitored Operations</h3>
            </div>
            <div class="panel-body">
                <div class="row">
                    <div class="col-md-6">
                        <h4>Operations</h4>
                        <ul class="list-group">
                            <li class="list-group-item"><span class="label label-success">CREATE</span> Entity creation operations</li>
                            <li class="list-group-item"><span class="label label-info">UPDATE</span> Entity modification operations</li>
                            <li class="list-group-item"><span class="label label-warning">DELETE</span> Entity deletion operations</li>
                        </ul>
                    </div>
                    <div class="col-md-6">
                        <h4>Monitored Entities</h4>
                        <ul class="list-group">
                            <li class="list-group-item">Students</li>
                            <li class="list-group-item">Courses</li>
                            <li class="list-group-item">Instructors</li>
                            <li class="list-group-item">Departments</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>

        <div class="well">
            <h4>Quick Test</h4>
            <p>To test the notification system, try performing any of the following operations:</p>
            <ul>
                <li><a asp-controller="Students" asp-action="Create" class="btn btn-sm btn-primary">Create a new student</a></li>
                <li><a asp-controller="Courses" asp-action="Create" class="btn btn-sm btn-success">Create a new course</a></li>
                <li><a asp-controller="Instructors" asp-action="Create" class="btn btn-sm btn-warning">Create a new instructor</a></li>
                <li><a asp-controller="Departments" asp-action="Create" class="btn btn-sm btn-info">Create a new department</a></li>
            </ul>
        </div>
    </div>
</div>
