@{
    ViewBag.Title = "Notifications";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row">
    <div class="col-md-12">
        <h2>@ViewBag.Title</h2>
        <p class="text-muted">Notifications for entity operations during this application session.</p>
        
        <div class="alert alert-info" role="alert">
            <strong>Notifications</strong><br />
            Entity changes are placed in an in-memory queue and displayed in the top-right corner while this application instance is running.
        </div>
        
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">
                    <i class="bi bi-bell"></i> Notification Settings
                </h3>
            </div>
            </div>
            <div class="panel-body">
                <div class="row">
                    <div class="col-md-6">
                        <h4>Monitored Operations</h4>
                        <ul class="list-group">
                            <li class="list-group-item">
                                <span class="label label-success">CREATE</span>
                                Entity creation operations
                            </li>
                            <li class="list-group-item">
                                <span class="label label-info">UPDATE</span>
                                Entity modification operations
                            </li>
                            <li class="list-group-item">
                                <span class="label label-warning">DELETE</span>
                                Entity deletion operations
                            </li>
                        </ul>
                    </div>
                    <div class="col-md-6">
                        <h4>Monitored Entities</h4>
                        <ul class="list-group">
                            <li class="list-group-item">
                                <i class="glyphicon glyphicon-user"></i>
                                Students
                            </li>
                            <li class="list-group-item">
                                <i class="glyphicon glyphicon-book"></i>
                                Courses
                            </li>
                            <li class="list-group-item">
                                <i class="glyphicon glyphicon-education"></i>
                                Instructors
                            </li>
                            <li class="list-group-item">
                                <i class="glyphicon glyphicon-briefcase"></i>
                                Departments
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="panel panel-default">
            <div class="panel-heading">
                <h3 class="panel-title">
                    <i class="glyphicon glyphicon-cog"></i> Technology Information
                </h3>
            </div>
            <div class="panel-body">
                <div class="alert alert-warning" role="alert">
                    <strong>Note:</strong> Notifications are stored in process memory and are lost when the application restarts.
                </div>
                
                <h4>Features:</h4>
                <ul>
                    <li><strong>Real-time delivery</strong> - Notifications appear immediately when operations occur</li>
                    <li><strong>Process-local messaging</strong> - Requests to this application instance share a concurrent queue</li>
                    <li><strong>Auto-dismiss</strong> - Notifications automatically disappear after 8 seconds</li>
                    <li><strong>User-friendly</strong> - Click the × to dismiss notifications manually</li>
                </ul>
                
                <p><strong>Check Interval:</strong> 5 seconds</p>
                <p><strong>Max Visible Notifications:</strong> 5 at a time</p>
            </div>
        </div>
        
        <div class="well">
            <h4>Quick Test</h4>
            <p>To test the notification system, try performing any of the following operations:</p>
            <ul>
                <li><a class="btn btn-sm btn-primary" asp-controller="Students" asp-action="Create">Create a new student</a></li>
                <li><a class="btn btn-sm btn-success" asp-controller="Courses" asp-action="Create">Create a new course</a></li>
                <li><a class="btn btn-sm btn-warning" asp-controller="Instructors" asp-action="Create">Create a new instructor</a></li>
                <li><a class="btn btn-sm btn-info" asp-controller="Departments" asp-action="Create">Create a new department</a></li>
            </ul>
            <p class="text-muted">After creating, editing, or deleting any entity, you should see a notification appear in the top-right corner of your screen.</p>
        </div>
    </div>
</div>
